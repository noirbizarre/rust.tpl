{%- set keyword_list = keywords | split(',') | map('trim') | select | list -%}
{%- set category_list = categories | split(',') | map('trim') | select | list -%}
# {{ crate }} — {{ description }}
#
{%- if is_workspace %}
# A Cargo workspace. This file is a virtual manifest: no [package] of its own,
# just the members and the [workspace.package]/[workspace.dependencies] tables
# they share. Add member crates below, past the marker — the template does not
# know their content.
{%- elif has_bin and has_lib %}
# Single crate, library + binary. The library (`src/lib.rs`) holds the engine;
# the binary (`src/main.rs`) is a thin CLI over it, so integration tests can
# exercise either. Cargo discovers both targets on its own.
{%- elif has_bin %}
# Single crate, binary only (`src/main.rs`). There is no library: the logic
# lives in private modules of the binary. Cargo discovers the target on its own.
{%- else %}
# Single crate, library only (`src/lib.rs`). Cargo discovers the target on its
# own.
{%- endif %}

{%- if is_workspace %}

[workspace]
# Virtual manifests carry no edition of their own to infer a resolver from —
# without this, Cargo silently defaults new members to the old (v1) resolver.
resolver = "3"
# Add your member crates here, e.g. members = ["crates/*"]. The template owns
# the workspace root, not what fills it.
members = []

[workspace.package]
{%- else %}

[package]
name = "{{ crate }}"
{%- endif %}
version = "0.1.0"
edition = "2024"
{%- if msrv %}
# The MSRV. Checked by the MSRV job in ci.yaml, which greps this very line — keep it
# a plain literal. `rust-toolchain.toml` separately pins the channel to develop
# against; the two answer different questions.
rust-version = "{{ msrv_version }}"
{%- endif %}
license = "MIT"
# No `authors`: Cargo/crates.io stopped generating and reading it after the
# 2021 edition — ownership on crates.io comes from the registry account that
# published, not this field. `author` still feeds LICENSE and, when `aur` is
# on, the PKGBUILD's `# Maintainer:` line.
description = "{{ description }}"
repository = "{{ repo_url }}"
{%- if docs %}
homepage = "{{ docs_url }}"
documentation = "{{ docs_url }}"
{%- endif %}
readme = "README.md"
keywords = [{% for keyword in keyword_list %}"{{ keyword }}"{% if not loop.last %}, {% endif %}{% endfor %}]
categories = [{% for category in category_list %}"{{ category }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{%- if not publish %}
# Not published to crates.io. Distribution is through the release assets alone,
# and `cargo install {{ crate }}` would create a second install path that
# nothing tests and nobody updates.
publish = false
{%- endif %}
{%- if has_bin %}

# cargo-binstall otherwise derives an asset name from the target triple, and
# the publish workflow's assets carry short platform suffixes instead (the
# `asset` field of each entry in `data/targets.toml`). A wrong guess is not an
# error: binstall silently falls back to compiling from source, which is the
# slow path this exists to avoid. So every target the publish workflow builds
# is mapped by hand, from that same catalogue — one override per selected
# target, so this list never drifts from the publish matrix.
#
# `pkg-fmt = "bin"`: the publish workflow uploads the raw executable, not an
# archive — see publish-release.yaml's "Stage the asset" step.
[package.metadata.binstall]
pkg-fmt = "bin"
{%- for entry in data.targets.matrix %}
{%- if entry.target in targets %}

[package.metadata.binstall.overrides.{{ entry.target }}]
pkg-url = "{ repo }/releases/download/{ version }/{{ crate }}_{ version }_{{ entry.asset }}{{ entry.ext }}"
{%- endif %}
{%- endfor %}
{%- if bin_name != crate %}

# Cargo names an automatic binary after the package, so a differently named one
# has to be declared. Nothing else is: the library and a same-named binary are
# discovered from `src/`.
[[bin]]
name = "{{ bin_name }}"
path = "src/main.rs"
{%- endif %}
{%- endif %}

[profile.release]
# Release binaries are cross-compiled once per tag and downloaded many times, so
# the build cost is paid once and the size saving is paid forward.
#
# Cargo only reads [profile.*] from a workspace's root manifest, so this stays
# unconditional: member crates inherit it whether or not this file also
# defines a [package].
lto = true
codegen-units = 1
strip = true

# --- project-specific --------------------------------------------------------
#
# Everything above this line is owned by the template and will keep updating.
# Everything below is yours.
#
# The template seeds what follows once, at `git tpl init`, and then leaves it
# alone: Dependabot bumps versions here weekly, and a template that propagated
# its own would open a conflict against every one of those PRs. Resolve in
# favour of the project if `git tpl update` ever touches it.
{%- if is_workspace %}

[workspace.dependencies]
# Shared versions for member crates to inherit via `dep = { workspace = true }`.
# Owned by the project and Dependabot from here, same deal as [dependencies]
# in the single-crate shapes.
{%- else %}

[dependencies]
# Errors & diagnostics. `thiserror` for typed errors inside the library,
# `miette` to render them at the binary edge.
thiserror = "2"
{%- if has_bin %}
miette = { version = "7", features = ["fancy"] }

# CLI
clap = { version = "4", features = ["derive", "env", "wrap_help"] }
console = "0.16"
demand = "2"
{%- else %}
# No `fancy` feature: that is the binary's terminal rendering, and a library
# should leave it to whoever links it.
miette = "7"
{%- endif %}

# Configuration & serialisation
serde = { version = "1", features = ["derive"] }
serde_json = { version = "1", features = ["preserve_order"] }

[dev-dependencies]
{%- if has_bin %}
assert_cmd = "2"
predicates = "3"
{%- endif %}
tempfile = "3"
insta = { version = "1", features = ["filters"] }
rstest = "0.26"
pretty_assertions = "1"
{%- if man_pages %}

[build-dependencies]
# Same derive feature as [dependencies]' `clap`, since build.rs recompiles
# src/cli.rs from scratch rather than linking against the library crate.
clap = { version = "4", features = ["derive", "env", "wrap_help"] }
clap_mangen = "0.2"
clap_complete = "4"
{%- endif %}
{%- endif %}
