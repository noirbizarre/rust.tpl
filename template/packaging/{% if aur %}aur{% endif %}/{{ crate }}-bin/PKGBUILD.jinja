# Maintainer: {{ author }}
#
# Prebuilt binary package. `@VERSION@` and the `@SHA256_*@` placeholders are
# substituted by .github/workflows/aur.yaml from the published release
# assets, and the result is pushed to the AUR. Edit this template, never the
# PKGBUILD in the AUR repository: that one is regenerated at every release.

pkgname={{ crate }}-bin
_pkgname={{ crate }}
pkgver=@VERSION@
pkgrel=1
pkgdesc="{{ description }} (prebuilt binary)"
arch=({% if "x86_64-unknown-linux-gnu" in targets %}'x86_64'{% endif %}{% if "aarch64-unknown-linux-gnu" in targets %} 'aarch64'{% endif %})
url="{{ repo_url }}"
license=('MIT')

provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")

# !strip because the release profile already sets `strip = true`, and !debug
# for the same reason: there is no debug data left to split into a -debug
# package, so building one would produce an empty package and a namcap
# warning.
options=('!strip' '!debug')

# The `gnu` asset, not `musl`: an AUR package targets Arch's own glibc.
# This project tags without a `v` prefix, so the tag is `$pkgver` as-is.
{%- if archive %}
#
# The release archive, not the raw executable: it carries the man pages,
# completions and service unit the bare binary cannot. makepkg extracts it into
# `$srcdir/<crate>-$pkgver-<asset>/`, laid out as a prefix.
{%- if "x86_64-unknown-linux-gnu" in targets %}
source_x86_64=("{{ bin_name }}-$pkgver-x86_64.tar.gz::$url/releases/download/$pkgver/{{ crate }}_${pkgver}_linux-amd64.tar.gz")
sha256sums_x86_64=('@SHA256_X86_64@')
{%- endif %}
{%- if "aarch64-unknown-linux-gnu" in targets %}
source_aarch64=("{{ bin_name }}-$pkgver-aarch64.tar.gz::$url/releases/download/$pkgver/{{ crate }}_${pkgver}_linux-arm64.tar.gz")
sha256sums_aarch64=('@SHA256_AARCH64@')
{%- endif %}

package() {
	case "$CARCH" in
		x86_64) _asset=linux-amd64 ;;
		aarch64) _asset=linux-arm64 ;;
	esac
	cd "$srcdir/{{ crate }}-$pkgver-$_asset"

	install -Dm755 bin/{{ bin_name }} "$pkgdir/usr/bin/{{ bin_name }}"
	# The rest of the archive is already laid out as `/usr`: man pages,
	# completions and the service unit land where they belong, and only what
	# the project actually ships is there to copy.
	[ -d share ] && cp -a share "$pkgdir/usr/"
	[ -d lib ] && cp -a lib "$pkgdir/usr/"
	# MIT is not one of the licences Arch keeps in /usr/share/licenses/common.
	install -Dm644 share/doc/{{ crate }}/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
{%- else %}
#
# The release asset is the raw executable itself, not an archive — makepkg
# leaves an unrecognised extension alone rather than trying to extract it, so
# these name it plainly and `package()` installs it directly.
{%- if "x86_64-unknown-linux-gnu" in targets %}
source_x86_64=("{{ bin_name }}-$pkgver-x86_64::$url/releases/download/$pkgver/{{ crate }}_${pkgver}_linux-amd64")
sha256sums_x86_64=('@SHA256_X86_64@')
{%- endif %}
{%- if "aarch64-unknown-linux-gnu" in targets %}
source_aarch64=("{{ bin_name }}-$pkgver-aarch64::$url/releases/download/$pkgver/{{ crate }}_${pkgver}_linux-arm64")
sha256sums_aarch64=('@SHA256_AARCH64@')
{%- endif %}

# Fetched separately: the raw binary asset carries no licence file, and MIT
# is not one of the licences Arch keeps in /usr/share/licenses/common.
{%- if service %}
# The systemd user unit is fetched from the tag for the same reason.
source=("LICENSE-$pkgver::$url/raw/$pkgver/LICENSE"
        "{{ bin_name }}-$pkgver.service::$url/raw/$pkgver/packaging/systemd/{{ crate }}.service")
sha256sums=('@SHA256_LICENSE@'
            '@SHA256_SERVICE@')
{%- else %}
source=("LICENSE-$pkgver::$url/raw/$pkgver/LICENSE")
sha256sums=('@SHA256_LICENSE@')
{%- endif %}

package() {
	install -Dm755 "$srcdir/{{ bin_name }}-$pkgver-$CARCH" "$pkgdir/usr/bin/{{ bin_name }}"
	install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
{%- if service %}
	# Package-owned user unit: `systemctl --user start {{ bin_name }}`.
	install -Dm644 "$srcdir/{{ bin_name }}-$pkgver.service" "$pkgdir/usr/lib/systemd/user/{{ bin_name }}.service"
{%- endif %}
}
{%- endif %}

# --- project-specific ---------------------------------------------------
#
# `depends=(...)` belongs here once `namcap` on a built package says what the
# binary actually links: a vendored dependency needs nothing declared, a
# dynamically linked one (a system OpenSSL, for example) does.
