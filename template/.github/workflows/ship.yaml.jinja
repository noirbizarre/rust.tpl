{%- raw %}
name: 🚢 Ship

# gh ship run routes each event to the right half of the release lifecycle:
# pushes prepare the Release PR, and merging it tags, drafts, builds assets,
# then makes the release public. Unrelated closed PRs skip successfully.
# Nothing to release costs one prepare-release run reporting changed: false.

on:
  push:
    branches: [main]
  pull_request:
    types: [closed]

# Release operations receive their credentials separately below.
permissions:
  contents: read

# Merging fires both triggers. Serialize them so the pending-release guard
# can stop preparation until publication finishes, regardless of event order.
# Never cancel: that would orphan the dispatched prepare or publish run.
concurrency:
  group: ship
  cancel-in-progress: false

jobs:
  ship:
    name: 🚢 Ship
    # Only ship releases from the configured owner's repository.
{%- endraw %}
    if: github.repository_owner == '{{ owner }}'
{%- if gh_ship_token_mode == 'token' %}
    permissions:
      contents: write
      actions: write
      pull-requests: write
      issues: write
{%- endif %}
{%- raw %}
    runs-on: ubuntu-latest
    # Leave orchestration headroom beyond the two-hour workflow wait below.
    timeout-minutes: 150

    # The environment holds release credentials, but orchestration is not itself
    # a deployment. Only Publish Release registers a release deployment.
    environment:
      name: release
      deployment: false

    steps:
      - uses: actions/checkout@v7
        with:
          # gh-ship authenticates its own operations without checkout's token.
          persist-credentials: false

      - name: Install gh-ship
        run: gh extension install noirbizarre/gh-ship
        env:
          GH_TOKEN: ${{ github.token }}

      - name: Ship the release
        run: gh ship run
        env:
{%- endraw %}
{%- if gh_ship_token_mode == 'app' %}
{%- raw %}
          # Only gh-ship needs the private key to mint and refresh its tokens.
          SHIP_APP_CLIENT_ID: ${{ vars.APP_CLIENT_ID }}
          SHIP_APP_PRIVATE_KEY: ${{ secrets.APP_PRIVATE_KEY }}
{%- endraw %}
{%- else %}
          GH_TOKEN: {% raw %}${{ secrets.SHIP_TOKEN || github.token }}{% endraw %}
{%- endif %}
{%- raw %}
          SHIP_RUN_TIMEOUT: 7200
{%- endraw %}
