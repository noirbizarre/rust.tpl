{%- macro validate_source() %}
      - name: Validate publication source
        env:
          BUILD_REF: ${{ '{{' }} inputs.ref || github.ref {{ '}}' }}
          CHANNEL_TAG: ${{ '{{' }} github.ref_name == (vars.PRERELEASE_NAME || 'development') {{ '}}' }}
        run: |
          fail() { echo '::error::Publish the run tag, the main CI SHA, or manually run on main with ref blank.'; exit 1; }
          # Names enter filenames and gh's file#label syntax, so Git validity alone is insufficient.
          [[ "$TAG" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*$ ]] || fail
          git check-ref-format "refs/tags/$TAG" || fail
          case "$BUILD_REF" in
            refs/tags/*)
              [[ "$BUILD_REF" == "$GITHUB_REF" && "$CHANNEL_TAG" != true ]] || fail
              ;;
            *)
{%- if rolling_prerelease and has_bin %}
              [[ "$GITHUB_REPOSITORY" == '{{ owner }}/{{ crate }}' && "$GITHUB_REF" == refs/heads/main ]] || fail
              [[ "$BUILD_REF" == "$GITHUB_SHA" || ("$GITHUB_EVENT_NAME" == workflow_dispatch && "$BUILD_REF" == refs/heads/main) ]] || fail
{%- else %}
              fail
{%- endif %}
              ;;
          esac
{%- endmacro %}
{%- raw %}
name: 📦 Publish Release
run-name: 📦 Publish Release ${{ inputs.ref || github.ref }}

on:
  workflow_dispatch:
    inputs:
      ref:
        description: Run tag or commit SHA; leave blank for a manual main rebuild
        required: false
        type: string
  workflow_call:
    inputs:
      ref:
        required: true
        type: string

permissions:
  contents: read

defaults:
  run:
    shell: bash

env:
  CARGO_TERM_COLOR: always
  CARGO_INCREMENTAL: "0"
  CARGO_NET_GIT_FETCH_WITH_CLI: "true"
  CARGO_NET_RETRY: "10"
  RUSTUP_MAX_RETRIES: "10"
  RUSTFLAGS: -D warnings
  # A tag input must match the run tag; other accepted inputs publish to the rolling channel.
  TAG: ${{ startsWith(inputs.ref || github.ref, 'refs/tags/') && github.ref_name || vars.PRERELEASE_NAME || 'development' }}

jobs:
{%- endraw %}
{%- if has_bin %}
{# Only reference an optional property if at least one selected object defines it (actionlint). #}
{%- set fields = namespace(cross=false, ext=false) %}
{%- for entry in data.targets.matrix %}
{%- if entry.target in targets %}
{%- set fields.cross = fields.cross or entry.cross %}
{%- set fields.ext = fields.ext or entry.ext != '' %}
{%- endif %}
{%- endfor %}
  build:
    name: 🏗️ Build (${{ '{{' }} matrix.build.label {{ '}}' }})
    runs-on: ${{ '{{' }} matrix.build.runner {{ '}}' }}
    strategy:
      fail-fast: false
      matrix:
        build:
{%- for entry in data.targets.matrix %}
{%- if entry.target in targets %}
          - { label: {{ entry.asset }}, target: {{ entry.target }}, runner: {{ entry.runner }}{% if entry.cross %}, cross: true{% endif %}{% if entry.ext %}, ext: "{{ entry.ext }}"{% endif %} }
{%- endif %}
{%- endfor %}
    steps:
{{ validate_source() }}
{%- raw %}
      - uses: actions/checkout@v7
        with:
          # Every matrix leg uses the immutable run commit, even if a tag or main moves later.
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.build.target }}
      - uses: Swatinem/rust-cache@v2
        with:
          key: release-${{ matrix.build.target }}
{%- endraw %}
{%- if fields.cross %}
{%- raw %}
      - uses: taiki-e/install-action@cross
        if: matrix.build.cross
{%- endraw %}
{%- endif %}
{%- raw %}
      # Standalone Windows binaries must start without a separately installed redistributable.
      - name: Statically link the MSVC C runtime
        if: endsWith(matrix.build.target, 'windows-msvc')
        run: echo "RUSTFLAGS=${RUSTFLAGS} -C target-feature=+crt-static" >> "$GITHUB_ENV"
      - name: Build and stage the asset
        env:
          TARGET: ${{ matrix.build.target }}
          LABEL: ${{ matrix.build.label }}
{%- endraw %}
{%- if fields.cross %}
{%- raw %}
          CROSS: ${{ matrix.build.cross }}
{%- endraw %}
{%- endif %}
{%- if fields.ext %}
{%- raw %}
          EXT: ${{ matrix.build.ext }}
{%- endraw %}
{%- endif %}
{%- raw %}
        run: |
          if [ "${CROSS:-}" = true ]; then
            cross build --release --locked --target "$TARGET"
          else
            cargo build --release --locked --target "$TARGET"
          fi
          mkdir -p dist
{%- endraw %}
          cp "target/${TARGET}/release/{{ bin_name }}${EXT:-}" "dist/{{ crate }}_${TAG}_${LABEL}${EXT:-}"
{%- raw %}
      - uses: actions/upload-artifact@v7
        with:
          name: asset-${{ matrix.build.label }}
          path: dist/*
          if-no-files-found: error
          retention-days: 7
{%- endraw %}
{%- endif %}

  publish:
    name: 🚀 Publish
{%- if has_bin %}
    needs: build
{%- endif %}
    runs-on: ubuntu-latest
    # Only uploads serialize; builds remain parallel and no partial upload is cancelled.
    concurrency:
      group: publish-release
      cancel-in-progress: false
{%- if has_bin or publish %}
    environment:
      name: release
      url: ${{ '{{' }} github.server_url {{ '}}' }}/${{ '{{' }} github.repository {{ '}}' }}/releases/tag/${{ '{{' }} env.TAG {{ '}}' }}
{%- endif %}
{%- if publish %}
    permissions:
      contents: read
      id-token: write
{%- endif %}
    steps:
{%- if not has_bin %}
{{ validate_source() }}
{%- endif %}
{%- if has_bin or publish %}
      - uses: actions/checkout@v7
        with:
          ref: ${{ '{{' }} github.sha {{ '}}' }}
          persist-credentials: false
{%- endif %}
{%- if has_bin %}
      - uses: actions/download-artifact@v8
        with:
          pattern: asset-*
          merge-multiple: true
          path: dist
{%- if archive %}
{%- if man_pages %}
      # Generate host-independent text once, rather than executing cross-compiled binaries.
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Generate man pages and completions
        run: |
          out=$(cargo build --locked --message-format=json 2>/dev/null \
            | jq -r 'select(.reason == "build-script-executed") | select(.package_id | test("{{ crate }}")) | .out_dir' \
            | tail -n 1)
          test -n "$out" || { echo 'could not locate OUT_DIR' >&2; exit 1; }
          mkdir -p stage/man stage/completions
          cp "$out"/man/*.1 stage/man/
          cp "$out"/completions/* stage/completions/
{%- endif %}
      # Both channels exercise the same reproducible prefix layout; Windows keeps its .exe.
      - name: Package the Unix binaries
        run: |
          export LC_ALL=C
          umask 022
          epoch=$(git log -1 --format=%ct)
          assets=({% for entry in data.targets.matrix %}{% if entry.target in targets and not entry.ext %}{{ entry.asset }} {% endif %}{% endfor %})
          for asset in "${assets[@]}"; do
            name="{{ crate }}-${TAG}-${asset}"
            root="stage/${name}"
            put() { if [ -f "$2" ]; then install -D -m "$1" "$2" "${root}/$3"; fi; }
            install -D -m 755 "dist/{{ crate }}_${TAG}_${asset}" "${root}/bin/{{ bin_name }}"
            install -D -m 644 LICENSE "${root}/share/doc/{{ crate }}/LICENSE"
            install -D -m 644 README.md "${root}/share/doc/{{ crate }}/README.md"
            for page in stage/man/*.1; do put 644 "$page" "share/man/man1/$(basename "$page")"; done
            put 644 stage/completions/{{ bin_name }}.bash "share/bash-completion/completions/{{ bin_name }}"
            put 644 stage/completions/_{{ bin_name }} "share/zsh/site-functions/_{{ bin_name }}"
            put 644 stage/completions/{{ bin_name }}.fish "share/fish/vendor_completions.d/{{ bin_name }}.fish"
{%- if service %}
            install -D -m 644 packaging/systemd/{{ crate }}.service "${root}/lib/systemd/user/{{ bin_name }}.service"
{%- endif %}
            tar -C stage --sort=name --format=gnu --mtime="@${epoch}" \
              --owner=0 --group=0 --numeric-owner -cf - "$name" \
              | gzip -n -9 > "dist/{{ crate }}_${TAG}_${asset}.tar.gz"
          done
{%- endif %}
      - name: Checksums
        working-directory: dist
        run: sha256sum -- * > SHA256SUMS
      - uses: actions/create-github-app-token@v3
        id: app-token
        with:
          client-id: ${{ '{{' }} vars.APP_CLIENT_ID {{ '}}' }}
          private-key: ${{ '{{' }} secrets.APP_PRIVATE_KEY {{ '}}' }}
      - name: Ensure the prerelease exists
        if: ${{ '{{' }} !startsWith(inputs.ref || github.ref, 'refs/tags/') {{ '}}' }}
        env:
          GH_TOKEN: ${{ '{{' }} steps.app-token.outputs.token {{ '}}' }}
        run: |
          gh release view "$TAG" >/dev/null 2>&1 ||
            gh release create "$TAG" --target "$GITHUB_SHA" --title "$TAG" \
              --notes 'Development build' --prerelease --latest=false
      - name: Upload assets to the release
        env:
          GH_TOKEN: ${{ '{{' }} steps.app-token.outputs.token {{ '}}' }}
        run: gh release upload "$TAG" dist/* --clobber
      - name: Update the rolling prerelease tag
        if: ${{ '{{' }} !startsWith(inputs.ref || github.ref, 'refs/tags/') {{ '}}' }}
        env:
          GH_TOKEN: ${{ '{{' }} steps.app-token.outputs.token {{ '}}' }}
        run: >-
          gh api -X PATCH "repos/${GITHUB_REPOSITORY}/git/refs/tags/${TAG}"
          -f sha="$GITHUB_SHA" -F force=true --silent
      - name: Finalize the prerelease
        if: ${{ '{{' }} !startsWith(inputs.ref || github.ref, 'refs/tags/') {{ '}}' }}
        env:
          GH_TOKEN: ${{ '{{' }} steps.app-token.outputs.token {{ '}}' }}
        run: |
          gh release edit "$TAG" --title "$TAG" --prerelease --draft=false --latest=false \
            --notes "Main SHA: ${GITHUB_SHA}. CI: ${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}"
{%- endif %}
{%- if publish %}
{%- if not (has_bin and archive and man_pages) %}
      - uses: dtolnay/rust-toolchain@stable
        if: startsWith(inputs.ref || github.ref, 'refs/tags/')
      - uses: Swatinem/rust-cache@v2
        if: startsWith(inputs.ref || github.ref, 'refs/tags/')
{%- endif %}
      # Last: an irreversible crates.io publication must follow successful binary uploads.
      - name: Check whether this version is already published
        id: existing
        if: startsWith(inputs.ref || github.ref, 'refs/tags/')
        run: |
          status=$(curl -sS -o /dev/null -w '%{http_code}' --retry 3 \
            -H 'User-Agent: {{ crate }}-release' "https://crates.io/api/v1/crates/{{ crate }}/${TAG}")
          case "$status" in
            200) echo 'published=true' >> "$GITHUB_OUTPUT" ;;
            404) echo 'published=false' >> "$GITHUB_OUTPUT" ;;
            *) echo '::error::Could not check the existing crate version; retry publication.'; exit 1 ;;
          esac
      - uses: rust-lang/crates-io-auth-action@v1
        id: auth
        if: startsWith(inputs.ref || github.ref, 'refs/tags/') && steps.existing.outputs.published == 'false'
      - name: Publish to crates.io
        if: startsWith(inputs.ref || github.ref, 'refs/tags/') && steps.existing.outputs.published == 'false'
        run: cargo publish --locked
        env:
          CARGO_REGISTRY_TOKEN: ${{ '{{' }} steps.auth.outputs.token {{ '}}' }}
{%- elif not has_bin %}
      - run: echo 'Nothing to publish.'
{%- endif %}
